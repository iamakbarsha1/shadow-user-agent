// Shadow User Agent Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Tracks every agent execution
model Run {
  id           String        @id @default(uuid()) @db.Uuid
  url          String
  personaId    String        @map("persona_id")
  status       String        @default("pending") // pending | running | complete | failed
  startedAt    DateTime      @default(now()) @map("started_at") @db.Timestamptz(3)
  completedAt  DateTime?     @map("completed_at") @db.Timestamptz(3)
  errorMessage String?       @map("error_message")

  observations Observation[]
  reports      Report[]
  testCases    TestCase[]

  @@index([status])
  @@index([startedAt])
  @@map("runs")
}

// Raw events captured during a run
model Observation {
  id         String       @id @default(uuid()) @db.Uuid
  runId      String       @map("run_id") @db.Uuid
  eventType  String       @map("event_type")
  payload    Json         @db.JsonB
  capturedAt DateTime     @default(now()) @map("captured_at") @db.Timestamptz(3)

  run         Run           @relation(fields: [runId], references: [id], onDelete: Cascade)
  screenshots Screenshot[]

  @@index([runId])
  @@index([eventType])
  @@map("observations")
}

// AI-generated reports
model Report {
  id         String   @id @default(uuid()) @db.Uuid
  runId      String   @map("run_id") @db.Uuid
  reportType String   @map("report_type") // 'bug_report' | 'ux_friction' | 'code_review'
  content    Json     @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([reportType])
  @@map("reports")
}

// API keys for programmatic access (MCP server, CLI)
model ApiKey {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  label     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([key])
  @@map("api_keys")
}

// Execution records for test cases (auto-healing history)
model TestExecution {
  id         String   @id @default(uuid()) @db.Uuid
  testCaseId String   @map("test_case_id") @db.Uuid
  status     String   // passed | failed | healed | error
  duration   Int      // milliseconds
  output     String?  @db.Text
  diagnosis  Json?    @db.JsonB
  healedCode String?  @map("healed_code") @db.Text
  executedAt DateTime @default(now()) @map("executed_at") @db.Timestamptz(3)

  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@index([testCaseId])
  @@index([executedAt])
  @@map("test_executions")
}

// Generated test cases from agent sessions
model TestCase {
  id          String    @id @default(uuid()) @db.Uuid
  runId       String    @map("run_id") @db.Uuid
  title       String
  description String?
  testCode    String    @map("test_code") @db.Text
  framework   String    @default("playwright")
  status      String    @default("generated") // 'generated' | 'passing' | 'failing' | 'stale'
  lastRunAt   DateTime? @map("last_run_at") @db.Timestamptz(3)
  lastResult  Json?     @map("last_result") @db.JsonB
  selectorMap Json?     @map("selector_map") @db.JsonB
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  run            Run             @relation(fields: [runId], references: [id], onDelete: Cascade)
  testExecutions TestExecution[]

  @@index([runId])
  @@index([status])
  @@map("test_cases")
}

// Scheduled recurring runs
model Schedule {
  id             String    @id @default(uuid()) @db.Uuid
  url            String
  personaId      String    @map("persona_id")
  cronExpression String    @map("cron_expression")
  enabled        Boolean   @default(true)
  label          String?
  generateTests  Boolean   @default(false) @map("generate_tests")
  lastRunAt      DateTime? @map("last_run_at") @db.Timestamptz(3)
  nextRunAt      DateTime? @map("next_run_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([enabled])
  @@map("schedules")
}

// Screenshots linked to observations
model Screenshot {
  id            String      @id @default(uuid()) @db.Uuid
  observationId String      @map("observation_id") @db.Uuid
  filePath      String      @map("file_path")
  capturedAt    DateTime    @default(now()) @map("captured_at") @db.Timestamptz(3)

  observation Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)

  @@index([observationId])
  @@map("screenshots")
}
