// Shadow User Agent Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Tracks every agent execution
model Run {
  id           String        @id @default(uuid()) @db.Uuid
  url          String
  personaId    String        @map("persona_id")
  status       String        @default("pending") // pending | running | complete | failed
  runType      String        @default("browser") @map("run_type") // "browser" | "api"
  startedAt    DateTime      @default(now()) @map("started_at") @db.Timestamptz(3)
  completedAt  DateTime?     @map("completed_at") @db.Timestamptz(3)
  errorMessage String?       @map("error_message")

  observations Observation[]
  reports      Report[]
  testCases    TestCase[]

  @@index([status])
  @@index([startedAt])
  @@map("runs")
}

// Raw events captured during a run
model Observation {
  id         String       @id @default(uuid()) @db.Uuid
  runId      String       @map("run_id") @db.Uuid
  eventType  String       @map("event_type")
  payload    Json         @db.JsonB
  capturedAt DateTime     @default(now()) @map("captured_at") @db.Timestamptz(3)

  run         Run           @relation(fields: [runId], references: [id], onDelete: Cascade)
  screenshots Screenshot[]

  @@index([runId])
  @@index([eventType])
  @@map("observations")
}

// AI-generated reports
model Report {
  id         String   @id @default(uuid()) @db.Uuid
  runId      String   @map("run_id") @db.Uuid
  reportType String   @map("report_type") // 'bug_report' | 'ux_friction' | 'code_review'
  content    Json     @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([reportType])
  @@map("reports")
}

// API keys for programmatic access (MCP server, CLI)
model ApiKey {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  label     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([key])
  @@map("api_keys")
}

// Execution records for test cases (auto-healing history)
model TestExecution {
  id         String   @id @default(uuid()) @db.Uuid
  testCaseId String   @map("test_case_id") @db.Uuid
  status     String   // passed | failed | healed | error
  duration   Int      // milliseconds
  output     String?  @db.Text
  diagnosis  Json?    @db.JsonB
  healedCode String?  @map("healed_code") @db.Text
  executedAt DateTime @default(now()) @map("executed_at") @db.Timestamptz(3)

  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@index([testCaseId])
  @@index([executedAt])
  @@map("test_executions")
}

// Generated test cases from agent sessions
model TestCase {
  id          String    @id @default(uuid()) @db.Uuid
  runId       String    @map("run_id") @db.Uuid
  title       String
  description String?
  testCode    String    @map("test_code") @db.Text
  framework   String    @default("playwright")
  status      String    @default("generated") // 'generated' | 'passing' | 'failing' | 'stale'
  lastRunAt   DateTime? @map("last_run_at") @db.Timestamptz(3)
  lastResult  Json?     @map("last_result") @db.JsonB
  selectorMap Json?     @map("selector_map") @db.JsonB
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  run                  Run                   @relation(fields: [runId], references: [id], onDelete: Cascade)
  testExecutions       TestExecution[]
  testGroupMemberships TestGroupMembership[]

  @@index([runId])
  @@index([status])
  @@map("test_cases")
}

// Groups of test cases for organized suite execution
model TestGroup {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  description   String?
  runOnSchedule Boolean   @default(false) @map("run_on_schedule")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships TestGroupMembership[]

  @@index([name])
  @@map("test_groups")
}

// Join table linking test cases to groups with ordering
model TestGroupMembership {
  id          String @id @default(uuid()) @db.Uuid
  testGroupId String @map("test_group_id") @db.Uuid
  testCaseId  String @map("test_case_id") @db.Uuid
  order       Int    @default(0)

  testGroup TestGroup @relation(fields: [testGroupId], references: [id], onDelete: Cascade)
  testCase  TestCase  @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@unique([testGroupId, testCaseId])
  @@index([testGroupId])
  @@index([testCaseId])
  @@map("test_group_memberships")
}

// Scheduled recurring runs
model Schedule {
  id             String    @id @default(uuid()) @db.Uuid
  url            String
  personaId      String    @map("persona_id")
  cronExpression String    @map("cron_expression")
  enabled        Boolean   @default(true)
  label          String?
  generateTests  Boolean   @default(false) @map("generate_tests")
  lastRunAt      DateTime? @map("last_run_at") @db.Timestamptz(3)
  nextRunAt      DateTime? @map("next_run_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([enabled])
  @@map("schedules")
}

// Tracks every billable action per user
model UsageRecord {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id")
  action    String   // run | test_generation | test_execution | group_execution
  cost      Int      // credits consumed
  relatedId String?  @map("related_id") // runId, testCaseId, or testGroupId
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([createdAt])
  @@map("usage_records")
}

// Credit budget per user (one row per user, auto-created on first use)
model CreditAllocation {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @map("user_id")
  totalCredits Int      @default(500) @map("total_credits")
  usedCredits  Int      @default(0) @map("used_credits")
  periodStart  DateTime @default(now()) @map("period_start") @db.Timestamptz(3)
  periodEnd    DateTime @map("period_end") @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("credit_allocations")
}

// Screenshots linked to observations
model Screenshot {
  id            String      @id @default(uuid()) @db.Uuid
  observationId String      @map("observation_id") @db.Uuid
  filePath      String      @map("file_path")
  capturedAt    DateTime    @default(now()) @map("captured_at") @db.Timestamptz(3)

  observation Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)

  @@index([observationId])
  @@map("screenshots")
}
