# ── Application ──────────────────────────────────────────────
NODE_ENV=development
APP_PORT=4000
FRONTEND_URL=http://localhost:3000

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://shadow:shadow@localhost:5432/shadow_agent

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Authentication ────────────────────────────────────────────
# Generate RSA keys with: ssh-keygen -t rsa -b 2048 -m PEM -f jwtRS256.key
# Then: openssl rsa -in jwtRS256.key -pubout -outform PEM -out jwtRS256.key.pub
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_PUBLIC_KEY_HERE\n-----END PUBLIC KEY-----"
INTERNAL_API_KEY=replace_with_random_64_char_string

# ── AI Provider (use one of the four below) ──────────────────
# Option 1: Google Gemini - free tier, no credit card required
# Get your API key from https://aistudio.google.com
# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-2.5-flash

# Option 2: Anthropic - direct access to Claude models
# ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Option 3: OpenRouter - OpenAI-compatible API with many models
# Supports: openai/gpt-4o, anthropic/claude-3-5-sonnet, etc.
# See https://openrouter.ai/docs for available models
# OPENROUTER_API_KEY=sk-or-your-key-here
# MODEL=anthropic/claude-sonnet-4-20250514

# Option 4: KIE.AI - Unified API for Claude and other models
# Uses Claude Sonnet model via KIE.AI's platform
# Get your API key from https://kie.ai/
# API Docs: https://docs.kie.ai/
# KIE_AI_API_KEY=your-kie-api-key-here
# KIE_MODEL=claude-sonnet-4-6

# ── File Storage ─────────────────────────────────────────────
SCREENSHOT_STORAGE_PATH=/tmp/agent-sessions

# For production S3 storage (optional):
# S3_BUCKET=shadow-agent-screenshots
# S3_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# ── Security ─────────────────────────────────────────────────
ALLOWED_INTERNAL_HOSTS=staging.concertIDC.internal,dev.concertIDC.internal

# ── Agent ────────────────────────────────────────────────────
AGENT_MAX_CONCURRENCY=3
AGENT_TIMEOUT_MS=180000
